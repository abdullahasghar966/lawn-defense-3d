# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The game runs with none of these set: sign-in still works, verification codes
# print to the server console instead of being emailed, and the Google button is
# hidden. Fill them in when you want the real flows.

# ---------------------------------------------------------------- required in production
# Signs session cookies and one-time codes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it a random secret is used, so every restart signs everyone out.
SESSION_SECRET=

# ---------------------------------------------------------------- Google sign-in
# From https://console.cloud.google.com/apis/credentials
#   Create credentials -> OAuth client ID -> Web application
#   Authorised JavaScript origins: http://localhost:5173  (plus your real domain)
# Only the client ID is needed. There is no client secret in this flow, and the
# client ID is public by design — it ships to the browser.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- email delivery
# Any SMTP provider. For Gmail you must use an App Password, not your login
# password (Google account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Lawn Defense 3D <no-reply@example.com>"

# ---------------------------------------------------------------- database
# Leave BOTH blank for local development: the server falls back to a SQLite file
# at ./data/lawn-defense.db and needs nothing installed.
#
# Set these for any serverless deployment (Vercel, Netlify, Cloudflare). Those
# platforms have an ephemeral filesystem, so a local SQLite file would lose every
# account on each cold start. Turso is hosted SQLite and speaks the same SQL:
#   1. https://turso.tech  ->  create a database (free tier, no card)
#   2. turso db show <name> --url        -> DATABASE_URL   (libsql://...)
#   3. turso db tokens create <name>     -> DATABASE_AUTH_TOKEN
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------- server
PORT=5173
# Set to production to require SESSION_SECRET and mark cookies Secure (HTTPS only).
NODE_ENV=development
# Number of proxy hops to trust for client IPs. Leave unset unless behind a proxy.
# TRUST_PROXY=1
# Where the SQLite file lives. Defaults to ./data/lawn-defense.db
# DB_FILE=
